{
  "name": "youareinthegame",
  "private": true,
  "type": "module",
  "description": "youareinthegame.com: Mushroom Platypus character/vignette site (Cloudflare Pages + Functions)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
