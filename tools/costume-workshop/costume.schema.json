{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local costume authoring format v1 (exports to existing site format)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","label","accessories"],
  "properties": {
    "schemaVersion": {"const":1},
    "id": {"$ref":"#/$defs/id"},
    "label": {"type":"string","minLength":1},
    "accessories": {"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","description","anchor","seed","removeWhiteBackground","placement"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "description":{"type":"string","minLength":1,"maxLength":2000},
        "anchor":{"enum":["head","bill-top","bill-bottom","mouth","eye-left","eye-right","eyes","handL","handR","bill"]},
        "seed":{"type":"integer","minimum":0},
        "source":{"type":"string","minLength":1,"description":"Local file relative to workshop, no traversal"},
        "guide":{"type":"string","minLength":1,"description":"Optional local shape guide for img2img generation"},
        "guideStrength":{"type":"number","exclusiveMinimum":0,"maximum":0.7},
        "removeWhiteBackground":{"type":"boolean"},
        "placement":{"type":"object","additionalProperties":false,"required":["objectAnchor","characterAnchor","scale","rotation","flipX"],"properties":{
          "objectAnchor":{"$ref":"#/$defs/objectPoint"},
          "characterAnchor":{"$ref":"#/$defs/characterPoint"},
          "scale":{"type":"number","exclusiveMinimum":0,"maximum":3},
          "rotation":{"type":"number"},
          "flipX":{"type":"boolean"}
        }}
      }
    }}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "objectPoint":{"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}}},
    "characterPoint":{"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"type":"number","minimum":-1,"maximum":2},"y":{"type":"number","minimum":-1,"maximum":2}}}
  }
}
