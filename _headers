/
  Cache-Control: public, max-age=60, must-revalidate

/index.html
  Cache-Control: public, max-age=60, must-revalidate

/worldmap/
  Cache-Control: public, max-age=60, must-revalidate

/script.js
  Cache-Control: public, max-age=300, must-revalidate

/styles.css
  Cache-Control: public, max-age=300, must-revalidate

/mainConfig.js
  Cache-Control: public, max-age=300, must-revalidate

# Shared badge (Cambio loads this cross-origin). Short cache so a replace
# on the public host updates both sites without a year-long immutable hold.
/img/tap-for-spores.png
  Cache-Control: public, max-age=60, must-revalidate
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed module URLs under effects/runtime — never immutable (stale POPs broke BOO).
/effects/*
  Cache-Control: public, max-age=60, must-revalidate

/runtime/*
  Cache-Control: public, max-age=60, must-revalidate

/content/*
  Cache-Control: public, max-age=60, must-revalidate

/api/contact
  Cache-Control: no-store

# Content-hash costume objects — Function also sets immutable; keep specific path first.
/api/assets/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: public, max-age=15, stale-while-revalidate=30
