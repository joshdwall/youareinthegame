{
  "schemaVersion": 1,
  "siteId": "youareinthegame",
  "enabled": true,
  "description": "MVP staging — Cloudflare Pages project youareinthegame-mvp (pages.dev only). Does NOT update youareinthegame.com apex.",
  "tenantId": "cloudflare-pages",
  "backoffProfile": "cloudflare-pages",
  "secretsRef": {
    "cloudflare": {
      "accountId": "secret://site.youareinthegame.cloudflare.account_id",
      "apiToken": "secret://site.youareinthegame.cloudflare.api_token"
    }
  },
  "cloudflare": {
    "projectName": "youareinthegame-mvp",
    "accountId": "${CLOUDFLARE_ACCOUNT_ID}",
    "branch": "main"
  },
  "publishRoot": ".pages-deploy",
  "preflight": {
    "requireAssemble": false,
    "requireResolvedTheme": false,
    "requireCleanGit": false
  }
}
